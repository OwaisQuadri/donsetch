# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Rust source files
*.rs text eol=lf

# Config and documentation
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf

# Binary files — never normalize
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.onnx binary
*.a binary
*.lib binary
*.dll binary
*.so binary
*.dylib binary
*.exe binary
